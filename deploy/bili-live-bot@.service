[Unit]
Description=Bilibili Live Robot - Room %i
After=network.target

# ╔══════════════════════════════════════════════════════════╗
# ║  此文件为 systemd 部署可选方案                           ║
# ║  新版 Ayabot 已内置 ProcessManager，WebUI 可直接管理    ║
# ║  子进程，无需 systemd。以下配置仅用于生产服务器场景。     ║
# ║  Windows / Docker / 本地开发：用 WebUI 启动/停止即可     ║
# ╚══════════════════════════════════════════════════════════╝

[Service]
Type=simple
User=root
WorkingDirectory=/root/ayabot
ExecStart=/root/ayabot/.venv/bin/python -m app.main --room %i
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
